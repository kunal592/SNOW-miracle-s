# App
APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://snow:snow@localhost:5432/snow_dev?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production_at_least_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# AI Provider (Gemini / OpenAI / etc)
AI_PROVIDER=gemini
AI_API_KEY=

# Cloudflare R2 (optional for dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=snow-files
R2_PUBLIC_URL=
